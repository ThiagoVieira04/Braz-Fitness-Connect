{
  "name": "braz-fitness-connect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:blob-client": "esbuild node_modules/@vercel/blob/dist/client.js --bundle --format=esm --platform=browser --minify --outfile=assets/js/vendor/vercel-blob-client.mjs",
    "check": "node --check api/catalog.js && node --check api/upload.js && node --check assets/js/admin.js && node --check assets/js/script.js"
  },
  "dependencies": {
    "@vercel/blob": "2.9.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
